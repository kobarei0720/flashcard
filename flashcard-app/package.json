{
  "name": "flashcard-app",
  "version": "1.0.0",
  "description": "AWS SAP-C02試験対策用のAnki風フラッシュカードアプリケーション",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "test": "vitest",
    "convert": "node scripts/convert_csv_to_json.js"
  },
  "keywords": [
    "flashcard",
    "aws",
    "sap-c02"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/core": "^8.2.0",
    "@capacitor/ios": "^8.2.0",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "express": "^5.1.0",
    "multer": "^2.1.1",
    "papaparse": "^5.5.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "happy-dom": "^20.8.4",
    "nodemon": "^3.1.9",
    "vite": "^6.2.2",
    "vitest": "^4.1.0"
  }
}
